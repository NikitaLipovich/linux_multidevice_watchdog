#!/bin/sh /etc/rc.common
# /etc/init.d/svc_watchdog — svc_watch v2 C observer daemon, under procd.
# procd respawns it if it dies; it protects itself from the OOM killer via
# framework.observer.oom_adj in /etc/svc_watch.conf. Installed + started by startup.sh.

START=98
STOP=11
USE_PROCD=1

PROG=/usr/local/home/root/external-storage-contents/svc_watchdog
CONF=/etc/svc_watch.conf

start_service() {
    procd_open_instance svc_watchdog
    procd_set_param command "$PROG" "$CONF"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
